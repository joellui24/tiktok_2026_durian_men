{
  "schema_version": "fm-training-v2",
  "dataset_version": "fm-trajectories-v2",
  "catalog_only_training": true,
  "trajectory": {
    "seed": 2026,
    "seed_role": "fixed question paths and synthetic evidence",
    "split_seed": 2026,
    "nested_trajectory_counts": [25000, 50000, 100000],
    "scenario_mix": "public",
    "public_scenario_proportions": {
      "buying": 0.4,
      "browsing": 0.4,
      "boundary": 0.05,
      "intent_override": 0.15
    },

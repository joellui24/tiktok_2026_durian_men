    "schema_version": "conversation-features-v2"
  },
  "negative_sampling": {
    "candidate_counts": [8, 16, 32],
    "default_count": 16,
    "pre_pool_size": 128,
    "mixture": {
      "model_hard": 0.5,
      "near_match": 0.25,
      "random": 0.25
    },
    "refresh_each_epoch": true
  },
  "model": {
    "independent_from_linear": true,
    "training_seed_role": "initialization, minibatches, and negative refresh",
    "final_training_seeds": [2026, 2027, 2028],
    "default_variant": "fm",
    "latent_dimensions": [8, 16, 32],
    "default_dimension": 16,
    "learning_rates": [0.005, 0.01, 0.02],
    "default_learning_rate": 0.01,
    "latent_l2_candidates": [1e-06, 1e-05, 0.0001],
    "linear_l2_candidates": [1e-06, 1e-05, 0.0001],
    "default_latent_l2": 1e-05,
    "default_linear_l2": 1e-05,

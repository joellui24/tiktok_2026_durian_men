  "selection": {
    "primary_metric": "full_survivor_validation_mrr",
    "learning_curve_plateau_minimum_mrr_gain": 0.002,
    "promotion_requires_official_correct": 199,
    "promotion_requires_official_mrr_above": 0.645863,
    "hit_rate_at_10_scope": "candidate_width_gt_10"
  }
